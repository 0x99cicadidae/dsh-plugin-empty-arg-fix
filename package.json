{
  "name": "dsh-plugin-empty-arg-fix",
  "version": "0.1.0",
  "private": true,
  "description": "Treat blank optional route arguments as omitted so models that send provider/model as empty strings work",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subagent",
    "tool-arguments"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
